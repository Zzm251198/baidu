# 复制本文件为 .env.local 并填入你的百度地图 AK（JS API / 地铁独立库均使用此 AK）
# 申请地址：https://lbsyun.baidu.com/apiconsole/key
# 建议在百度控制台为 AK 配置 Referer 白名单，防止被盗用
VITE_BMAP_SUBWAY_AK=你的百度地图AK

# ── 数据源开关 ────────────────────────────────────────────────
# mock（默认）：本地确定性生成演示数据，clone 下来即可跑
# http        ：改调后端接口 GET {VITE_API_BASE}/lines|waybills|fleet|alerts
VITE_DATA_SOURCE=mock

# 仅当 VITE_DATA_SOURCE=http 时生效，默认 /api
# VITE_API_BASE=http://localhost:8000/api
